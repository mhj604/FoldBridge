# Keep the real .env and .p8 files outside source control.
RELAY_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APNS_TEAM_ID=YOUR_TEAM_ID
APNS_KEY_ID=YOUR_KEY_ID
APNS_TOPIC=dev.foldbridge.watch
APNS_KEY_FILE=/absolute/private/path/AuthKey.p8
# Xcode-installed development builds use sandbox. App Store/TestFlight uses production.
APNS_ENVIRONMENT=sandbox
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
RELAY_DOMAIN=watch.example.com
